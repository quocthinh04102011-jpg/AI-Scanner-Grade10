
name: AI Scanner Build APK

on:
  workflow_dispatch:
  push:
    branches:
      - main
      - master

permissions:
  contents: read

jobs:
  build:
    name: Build USER and ADMIN APK
    runs-on: ubuntu-latest

    steps:
      # 1. Lay ma nguon GitHub
      - name: Checkout repository
        uses: actions/checkout@v4

      # 2. Cai Android SDK va chap nhan license
      - name: Setup Android SDK
        uses: android-actions/setup-android@v3
        with:
          accept-android-sdk-licenses: true

      # 3. Cai Java 17
      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      # 4. Cai Gradle 8.9
      # ZIP cua ban khong co gradlew
      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      # 5. Cai Android SDK 35
      - name: Install Android SDK packages
        shell: bash
        run: |
          set -e

          sdkmanager \
            "platforms;android-35" \
            "build-tools;35.0.0"

      # 6. Tim ZIP nguon
      - name: Find source ZIP
        id: source
        shell: bash
        run: |
          set -e

          ZIP_FILE="AI_Scanner_Grade10_Starter.zip"

          if [ ! -f "$ZIP_FILE" ]; then
            echo "ERROR: Khong tim thay ZIP nguon."
            echo "Hay upload ZIP vao goc repository."
            echo "Cac file ZIP dang co:"
            find . -type f -iname "*.zip"
            exit 1
          fi

          echo "zip=$ZIP_FILE" >> "$GITHUB_OUTPUT"

      # 7. Giai nen ZIP
      - name: Extract source ZIP
        shell: bash
        run: |
          set -e

          mkdir -p source

          unzip -o "${{ steps.source.outputs.zip }}" -d source

          echo "Cau truc nguon:"
          find source -maxdepth 4 -type d

      # 8. Xac nhan project USER
      - name: Check USER project
        shell: bash
        run: |
          set -e

          USER_DIR="source/ai_scanner_grade10/user-android"

          if [ ! -f "$USER_DIR/settings.gradle.kts" ]; then
            echo "ERROR: Khong tim thay USER settings.gradle.kts"
            find source -type f
            exit 1
          fi

          if [ ! -f "$USER_DIR/app/build.gradle.kts" ]; then
            echo "ERROR: Khong tim thay USER app/build.gradle.kts"
            exit 1
          fi

          echo "USER project OK"

      # 9. Xac nhan project ADMIN
      - name: Check ADMIN project
        shell: bash
        run: |
          set -e

          ADMIN_DIR="source/ai_scanner_grade10/admin-android"

          if [ ! -f "$ADMIN_DIR/settings.gradle.kts" ]; then
            echo "ERROR: Khong tim thay ADMIN settings.gradle.kts"
            find source -type f
            exit 1
          fi

          if [ ! -f "$ADMIN_DIR/app/build.gradle.kts" ]; then
            echo "ERROR: Khong tim thay ADMIN app/build.gradle.kts"
            exit 1
          fi

          echo "ADMIN project OK"

      # 10. Build USER APK
      - name: Build USER APK
        shell: bash
        run: |
          set -e

          gradle \
            --no-daemon \
            --stacktrace \
            -p source/ai_scanner_grade10/user-android \
            assembleDebug

      # 11. Build ADMIN APK
      - name: Build ADMIN APK
        shell: bash
        run: |
          set -e

          gradle \
            --no-daemon \
            --stacktrace \
            -p source/ai_scanner_grade10/admin-android \
            assembleDebug

      # 12. Tao thu muc APK
      - name: Prepare APK files
        shell: bash
        run: |
          set -e

          mkdir -p output

          USER_APK="source/ai_scanner_grade10/user-android/app/build/outputs/apk/debug/app-debug.apk"

          ADMIN_APK="source/ai_scanner_grade10/admin-android/app/build/outputs/apk/debug/app-debug.apk"

          if [ ! -f "$USER_APK" ]; then
            echo "ERROR: Khong tim thay APK USER"
            find source/ai_scanner_grade10/user-android -type f -name "*.apk"
            exit 1
          fi

          if [ ! -f "$ADMIN_APK" ]; then
            echo "ERROR: Khong tim thay APK ADMIN"
            find source/ai_scanner_grade10/admin-android -type f -name "*.apk"
            exit 1
          fi

          cp "$USER_APK" output/AI-Scanner-USER.apk

          cp "$ADMIN_APK" output/AI-Scanner-ADMIN.apk

          echo "APK da tao:"
          ls -lh output/

      # 13. Upload APK
      - name: Upload APK files
        uses: actions/upload-artifact@v4
        with:
          name: AI-Scanner-APK
          path: output/*.apk
          if-no-files-found: error
          retention-days: 30
